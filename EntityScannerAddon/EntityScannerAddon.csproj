<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>EntityScanner</AssemblyName>
        <RootNamespace>PantheonAddons.EntityScanner</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="..\PantheonAddons\EntityScanner\EntityScanner.cs" Link="EntityScanner.cs" />
        <ProjectReference Include="..\PantheonAddonFramework\PantheonAddonFramework.csproj" />
    </ItemGroup>

    <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(SkipDeploy)' != 'true'">
        <ItemGroup>
            <FilesToCopy Include="$(TargetDir)EntityScanner.dll" />
        </ItemGroup>
        <MakeDir Directories="$(GamePath)/Mods/PantheonAddons" />
        <Copy SourceFiles="@(FilesToCopy)" DestinationFolder="$(GamePath)/Mods/PantheonAddons" />
    </Target>

</Project>
